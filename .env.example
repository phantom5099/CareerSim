# PostgreSQL（本地回环；生产同机部署也走本地 socket 或回环）
POSTGRES_USER=careersim
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=careersim
DATABASE_URL=postgres://careersim:change-me-locally@127.0.0.1:5432/careersim
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# 模型供应商：openai | deepseek | glm
MODEL_PROVIDER=
MODEL=
MODEL_BASE_URL=
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
# 模型结构化输出能力开关（按模型实测勾选；不存在 JSON_OBJECT 模式）
MODEL_STRICT_SCHEMA=false
MODEL_FORCED_TOOL_CHOICE=false

# HTTP 服务绑定地址
HTTP_BIND=127.0.0.1:3000
# Cookie Secure 属性；生产必须 true，本地 http 联调可改 false（HttpOnly 恒开启）
HTTP_COOKIE_SECURE=false
# 非 GET 请求允许的 Origin，逗号分隔；必填
HTTP_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Argon2id 参数（OWASP 推荐下限；低于下限将拒绝启动）
ARGON2_M_COST_KIB=19456
ARGON2_T_COST=2
ARGON2_P_COST=1

# 简历附件存储目录
RESUME_STORAGE_DIR=data/resumes

# 每回合最多模型调用步数
MAX_STEPS=8

# 只填当前 MODEL_PROVIDER 对应的一个
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

RUST_LOG=info
