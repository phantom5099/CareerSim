# PostgreSQL（本地回环；生产同机部署也走本地 socket 或回环）
POSTGRES_USER=careersim
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=careersim
DATABASE_URL=postgres://careersim:change-me-locally@127.0.0.1:5432/careersim
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# 模型供应商：openai | deepseek | glm
MODEL_PROVIDER=
MODEL=
MODEL_BASE_URL=
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# 每回合最多模型调用步数
MAX_STEPS=8

# HTTP 服务
# demo：启用内置演示账号；live：不加载演示凭据，当前登录接口不可用
APP_MODE=demo
HTTP_ADDR=127.0.0.1:3000
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
AUTH_TOKEN_TTL_SECS=604800

# 仅 APP_MODE=demo 时加载；live 模式忽略这些值
DEMO_USERNAME=admin
DEMO_PASSWORD=123456

# 只填当前 MODEL_PROVIDER 对应的一个
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

RUST_LOG=info
